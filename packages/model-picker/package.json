{
  "name": "@dsh-local/hermes-model-picker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hermes-style composer model picker: search, favorites, collapsible provider groups, per-model reasoning levels.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
