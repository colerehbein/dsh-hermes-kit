#!/usr/bin/env python3
"""proj — the project registry: import, list, inspect, and stub new projects.

  proj import [--db PATH]        # read Hermes projects.db into ~/.dsh/projects/projects.json
  proj list                      # slug, folders, README/TODO state
  proj show <slug>               # details + open todo items
  proj stubs [--apply]           # create README.md / TODO.md where missing
  proj todo <slug>               # print that project's TODO.md

Registry: $DSH_HOME/projects/projects.json. Import is read-only on the source DB.
"""
import argparse
import json
import os
import shutil
import sqlite3
import sys
import tempfile
import time
from pathlib import Path

DSH = Path(os.environ.get("DSH_HOME", "~/.dsh")).expanduser()
REG = DSH / "projects" / "projects.json"
DEFAULT_DB = Path.home() / ".hermes" / "projects.db"

README_TMPL = """# {name}

> One line: what this is, and who it is for.

## Status

- Imported from Hermes projects on {date}.
- Folders: {folders}

## How to run it

_TBD — replace this with the commands that actually start the thing._

## Notes

_Longer context belongs here, not in the TODO._
"""

TODO_TMPL = """# TODO — {name}

## Next

- [ ] First concrete next action

## Later

- [ ]
"""


def load(path=REG):
    if not REG.exists():
        sys.exit(f"no registry yet — run `proj import`")
    return json.loads(REG.read_text())


def save(data):
    REG.parent.mkdir(parents=True, exist_ok=True)
    REG.write_text(json.dumps(data, indent=2) + "\n")


def connect_ro(path):
    try:
        db = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
        db.execute("select count(*) from projects").fetchone()
        return db
    except sqlite3.OperationalError:
        # WAL sidecar or a lock the sandbox will not open: read a copy instead.
        tmp = Path(tempfile.mkdtemp()) / "projects.db"
        shutil.copy2(path, tmp)
        for suffix in ("-wal", "-shm"):
            side = Path(str(path) + suffix)
            if side.exists():
                shutil.copy2(side, Path(str(tmp) + suffix))
        return sqlite3.connect(str(tmp))


def read_hermes_db(path):
    if not path.exists():
        sys.exit(f"no database at {path}")
    db = connect_ro(path)
    db.row_factory = sqlite3.Row
    folders = {}
    for row in db.execute("select project_id, path, is_primary from project_folders"):
        folders.setdefault(row["project_id"], []).append((row["path"], row["is_primary"]))
    projects = []
    for row in db.execute("select * from projects order by slug"):
        fl = folders.get(row["id"], [])
        fl.sort(key=lambda item: item[1], reverse=True)
        paths = [p for p, _ in fl]
        projects.append({
            "slug": row["slug"],
            "name": row["name"],
            "description": row["description"] or "",
            "folders": paths,
            "primary": row["primary_path"] or (paths[0] if paths else ""),
            "status": "archived" if row["archived"] else "active",
            "hermes_id": row["id"],
            "created": row["created_at"],
            "readme": False,
            "todo": False,
        })
    meta = {row["key"]: row["value"] for row in db.execute("select key, value from project_meta")}
    db.close()
    active_id = meta.get("active_id", "")
    return projects, active_id


def project_by_slug(data, slug):
    for project in data["projects"]:
        if project["slug"] == slug:
            return project
    sys.exit(f"no project {slug!r}")


def flags(project):
    primary = Path(project["primary"]) if project["primary"] else None
    if not primary or not primary.exists():
        return "missing", True, True
    return "ok", (primary / "README.md").exists(), (primary / "TODO.md").exists()


def index_path():
    return DSH / "projects" / "sessions.jsonl"


def load_index():
    path = index_path()
    if not path.exists():
        return []
    rows = []
    for line in path.read_text().splitlines():
        if line.strip():
            try:
                rows.append(json.loads(line))
            except json.JSONDecodeError:
                pass
    return rows


def match_project(cwd, projects):
    best = None
    for project in projects:
        for folder in project["folders"]:
            root = folder.rstrip("/")
            if cwd == root or cwd.startswith(root + "/"):
                if best is None or len(root) > best[0]:
                    best = (len(root), project["slug"])
    return best[1] if best else None


def iso(ts):
    if not ts:
        return ""
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(float(ts)))


def cmd_index(a):
    data = load()
    projects = data["projects"]
    rows = []

    src = Path(a.state).expanduser()
    if src.exists():
        db = sqlite3.connect(f"file:{src}?immutable=1", uri=True)
        db.row_factory = sqlite3.Row
        for r in db.execute(
            "select id, cwd, title, started_at, message_count, tool_call_count "
            "from sessions where cwd is not null"
        ):
            rows.append({
                "source": "hermes",
                "id": r["id"],
                "cwd": r["cwd"],
                "project": match_project(r["cwd"], projects),
                "title": r["title"] or "",
                "started": iso(r["started_at"]),
                "messages": r["message_count"] or 0,
                "tools": r["tool_call_count"] or 0,
            })
        db.close()
    else:
        print(f"no Hermes state.db at {src}", file=sys.stderr)

    from compression import zstd as _zstd
    for sess in (DSH / "sessions").glob("*/*"):
        f = sess / "session.v4.jsonl.zstd"
        if not f.exists():
            continue
        try:
            text = _zstd.decompress(f.read_bytes()).decode("utf-8", "replace")
        except Exception:
            continue
        cwd = created = None
        events = 0
        for line in text.splitlines():
            events += 1
            if cwd is None:
                try:
                    ev = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if ev.get("type") == "session":
                    cwd = ev.get("cwd")
                    created = ev.get("createdAt")
        if not cwd:
            continue
        rows.append({
            "source": "dsh",
            "id": sess.name,
            "cwd": cwd,
            "project": match_project(cwd, projects),
            "title": "",
            "started": iso((created or 0) / 1000),
            "events": events,
        })

    rows.sort(key=lambda r: r.get("started") or "", reverse=True)
    path = index_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("".join(json.dumps(r) + "\n" for r in rows))

    assigned = sum(1 for r in rows if r.get("project"))
    print(f"{len(rows)} sessions indexed · {assigned} mapped · {len(rows) - assigned} unassigned")
    per = {}
    for r in rows:
        if r.get("project"):
            per[r["project"]] = per.get(r["project"], 0) + 1
    for project in sorted(projects, key=lambda p: -per.get(p["slug"], 0)):
        n = per.get(project["slug"], 0)
        if n:
            print(f"  {project['slug']:<22} {n}")
    print(f"wrote {path}")


def cmd_sessions(a):
    project = project_by_slug(load(), a.slug)
    rows = [r for r in load_index() if r.get("project") == project["slug"]]
    if not rows:
        print(f"no indexed sessions for {a.slug} — run `proj index`")
        return
    for r in rows[: a.limit]:
        date = (r.get("started") or "")[:10]
        mark = "H" if r["source"] == "hermes" else "D"
        title = (r.get("title") or r["id"])[:78]
        print(f"{date}  {mark}  {title}")
    print(f"\n{len(rows)} sessions" + (f", newest {a.limit} shown" if len(rows) > a.limit else ""))


def cmd_import(a):
    projects, active_id = read_hermes_db(Path(a.db).expanduser())
    active = next((p["slug"] for p in projects if p["hermes_id"] == active_id), "")
    for project in projects:
        _, has_readme, has_todo = flags(project)
        project["readme"], project["todo"] = has_readme, has_todo
    previous = json.loads(REG.read_text()) if REG.exists() else {"projects": []}
    by_id = {p.get("hermes_id"): p for p in previous["projects"] if p.get("hermes_id")}
    by_slug = {p["slug"]: p for p in previous["projects"]}
    merged = []
    for project in projects:
        prev = by_id.get(project["hermes_id"]) or by_slug.get(project["slug"])
        if prev:
            project["name"] = prev.get("name") or project["name"]
            project["description"] = prev.get("description") or project["description"]
        merged.append(project)
    taken = {p["slug"] for p in merged}
    for project in previous["projects"]:
        if not project.get("hermes_id") and project["slug"] not in taken:
            merged.append(project)
    projects = merged

    data = {
        "version": 1,
        "imported_from": str(Path(a.db).expanduser()),
        "imported_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "active": active,
        "projects": projects,
    }
    save(data)
    missing = [p["slug"] for p in projects if flags(p)[0] == "missing"]
    print(f"{len(projects)} projects · active {active or '—'} · {len(missing)} with missing folders")
    for slug in missing:
        print(f"  missing folder: {slug}")
    print(f"wrote {REG}")


def cmd_adopt(a):
    data = load() if REG.exists() else {"version": 1, "projects": []}
    have = {p["slug"] for p in data["projects"]}
    added, skipped = [], []
    for raw in a.paths:
        folder = Path(raw).expanduser().resolve()
        if not folder.is_dir():
            print(f"skip {folder}: not a directory")
            continue
        slug = (a.slug if a.slug and len(a.paths) == 1 else folder.name.lower().replace(" ", "-"))
        if slug in have:
            skipped.append(slug)
            continue
        data["projects"].append({
            "slug": slug,
            "name": a.name or folder.name,
            "description": "",
            "folders": [str(folder)],
            "primary": str(folder),
            "status": "active",
            "hermes_id": "",
            "created": int(time.time()),
            "readme": (folder / "README.md").exists(),
            "todo": (folder / "TODO.md").exists(),
        })
        have.add(slug)
        added.append(slug)
    save(data)
    print(f"adopted {len(added)}: {', '.join(added) or '—'}")
    if skipped:
        print(f"already present: {', '.join(skipped)}")


def cmd_list(a):
    data = load()
    last = {}
    for row in load_index():
        slug = row.get("project")
        if slug and (slug not in last or row.get("started", "") > last[slug]):
            last[slug] = row.get("started", "")
    for project in data["projects"]:
        state, has_readme, has_todo = flags(project)
        marks = f'{"R" if has_readme else "-"}{"T" if has_todo else "-"}'
        folders = len(project["folders"])
        star = "*" if project["slug"] == data.get("active") else " "
        seen = (last.get(project["slug"]) or "")[:10] or "—"
        print(f'{star} {project["slug"]:<22} {marks}  {seen}  '
              f'{"MISSING" if state == "missing" else project["primary"]}')


def cmd_show(a):
    project = project_by_slug(load(), a.slug)
    state, has_readme, has_todo = flags(project)
    print(f'{project["name"]}  ({project["slug"]})')
    if project["description"]:
        print(f'  {project["description"]}')
    print(f'  status   {project["status"]}')
    print(f'  folders  {", ".join(project["folders"]) or "—"}')
    print(f'  readme   {"yes" if has_readme else "no"}')
    print(f'  todo     {"yes" if has_todo else "no"}')
    if state == "missing":
        print("  folder   MISSING on disk")
        return
    todo = Path(project["primary"]) / "TODO.md"
    if todo.exists():
        items = [line.strip() for line in todo.read_text().splitlines() if line.strip().startswith("- [ ]")]
        print(f'  open     {len(items)} item(s)')


def cmd_todo(a):
    project = project_by_slug(load(), a.slug)
    todo = Path(project["primary"]) / "TODO.md"
    if not todo.exists():
        sys.exit(f"no TODO.md in {project['primary']}")
    print(todo.read_text().rstrip())


def cmd_stubs(a):
    data = load()
    created, existing, missing = 0, 0, 0
    for project in data["projects"]:
        primary = Path(project["primary"])
        if not primary.is_dir():
            print(f"skip   {project['slug']}: {primary} is not a directory")
            missing += 1
            continue
        for fname, template in (("README.md", README_TMPL), ("TODO.md", TODO_TMPL)):
            target = primary / fname
            if target.exists():
                existing += 1
                continue
            body = template.format(
                name=project["name"],
                date=time.strftime("%Y-%m-%d"),
                folders=", ".join(project["folders"]) or primary,
            )
            if a.apply:
                target.write_text(body)
            print(f'{"create" if a.apply else "would create"} {target}')
            created += 1
        project["readme"] = (primary / "README.md").exists()
        project["todo"] = (primary / "TODO.md").exists()
    if a.apply:
        data["stubs_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        save(data)
    print(f"\n{created} {'created' if a.apply else 'to create'} · {existing} already present · "
          f"{missing} projects without a folder")


def main():
    p = argparse.ArgumentParser(prog="proj", description="project registry")
    sub = p.add_subparsers(dest="cmd", required=True)

    i = sub.add_parser("import")
    i.add_argument("--db", default=str(DEFAULT_DB))
    i.set_defaults(fn=cmd_import)

    l = sub.add_parser("list")
    l.set_defaults(fn=cmd_list)

    s = sub.add_parser("show")
    s.add_argument("slug")
    s.set_defaults(fn=cmd_show)

    t = sub.add_parser("todo")
    t.add_argument("slug")
    t.set_defaults(fn=cmd_todo)

    ix = sub.add_parser("index")
    ix.add_argument("--state", default=str(Path.home() / "hermes-exit-2026-11-07" / "sessions" / "state.db"))
    ix.set_defaults(fn=cmd_index)

    se = sub.add_parser("sessions")
    se.add_argument("slug")
    se.add_argument("-n", "--limit", type=int, default=10)
    se.set_defaults(fn=cmd_sessions)

    ad = sub.add_parser("adopt")
    ad.add_argument("paths", nargs="+")
    ad.add_argument("--name")
    ad.add_argument("--slug")
    ad.set_defaults(fn=cmd_adopt)

    st = sub.add_parser("stubs")
    st.add_argument("--apply", action="store_true")
    st.set_defaults(fn=cmd_stubs)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
